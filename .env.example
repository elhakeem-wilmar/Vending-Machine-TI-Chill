# Sandbox / Production Toggle
# Ubah ke true jika sudah aktivasi Production di Midtrans
IS_PRODUCTION=false

# Port Server
PORT=3000

# === Kredensial Midtrans ===
# Ambil di https://dashboard.midtrans.com/ -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-MASUKKAN_SERVER_KEY_SANDBOX_DISINI
MIDTRANS_CLIENT_KEY=SB-Mid-client-MASUKKAN_CLIENT_KEY_SANDBOX_DISINI

# === Admin Dashboard ===
ADMIN_PIN=1234


